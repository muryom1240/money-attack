---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<div class="logo">
			<a href={`${import.meta.env.BASE_URL}/`}>
				<span class="logo-icon">🏰</span>
				<span class="logo-text">{SITE_TITLE}</span>
			</a>
		</div>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/privacy">Privacy</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://artwldesign.booth.pm/" target="_blank" class="booth-link">
				🛝 BOOTH Shop
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1.5em;
		background: rgba(15, 10, 30, 0.85);
		backdrop-filter: blur(16px);
		border-bottom: 1px solid rgba(192, 132, 252, 0.25);
		position: sticky;
		top: 0;
		z-index: 100;
		box-shadow: 0 2px 20px rgba(0, 0, 0, 0.4), 0 0 40px rgba(139, 92, 246, 0.08);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 64px;
		max-width: 1100px;
		margin: 0 auto;
	}
	.logo a {
		display: flex;
		align-items: center;
		gap: 0.5em;
		text-decoration: none;
		transition: all 0.3s ease;
	}
	.logo a:hover {
		filter: brightness(1.2);
	}
	.logo-icon {
		font-size: 1.5em;
	}
	.logo-text {
		font-family: 'Cinzel', serif;
		font-size: 0.9em;
		font-weight: 700;
		background: linear-gradient(135deg, #fcd34d, #c084fc);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		letter-spacing: 0.03em;
		white-space: nowrap;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.25em;
	}
	.social-links {
		display: flex;
		align-items: center;
	}
	.booth-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		padding: 0.4em 1em;
		background: linear-gradient(135deg, rgba(245, 158, 11, 0.2), rgba(192, 132, 252, 0.2));
		border: 1px solid rgba(245, 158, 11, 0.5);
		border-radius: 20px;
		color: #fcd34d !important;
		font-size: 0.85em;
		font-weight: 700;
		text-decoration: none !important;
		transition: all 0.3s ease;
		white-space: nowrap;
	}
	.booth-link:hover {
		background: linear-gradient(135deg, rgba(245, 158, 11, 0.4), rgba(192, 132, 252, 0.4));
		border-color: #fcd34d;
		box-shadow: 0 0 16px rgba(245, 158, 11, 0.4);
		transform: translateY(-1px);
		text-shadow: none !important;
	}
	@media (max-width: 768px) {
		.logo-text { font-size: 0.75em; }
		.social-links { display: none; }
		.internal-links { gap: 0; }
	}
	@media (max-width: 480px) {
		nav { height: auto; padding: 0.75em 0; flex-wrap: wrap; gap: 0.5em; }
		.logo-text { display: none; }
	}
</style>
