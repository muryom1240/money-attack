---
const today = new Date();
---

<footer>
	<div class="footer-stars">✦ ✧ ⋆ ✦ ✧ ⋆ ✦ ✧ ⋆ ✦</div>
	<div class="footer-links">
		<a href="https://artwldesign.booth.pm/" target="_blank" class="booth-btn">
			🛝 BOOTHショップへ
		</a>
	</div>
	<div class="footer-nav">
		<a href="/money-attack/">Home</a>
		<a href="/money-attack/blog/">Blog</a>
		<a href="/money-attack/about/">About</a>
		<a href="/money-attack/privacy/">Privacy</a>
		<a href="/money-attack/contact/">Contact</a>
	</div>
	<p class="footer-copy">
		© {today.getFullYear()} アートウル工房 / Artoul Atelier. All rights reserved.
	</p>
	<p class="footer-desc">ローポリ3DCGモデルを制作・販売するクリエイターの工房</p>
</footer>

<style>
	footer {
		padding: 3em 1em 4em;
		background: linear-gradient(to top, rgba(15,10,30,1), rgba(26,16,53,0.8));
		border-top: 1px solid rgba(192, 132, 252, 0.2);
		text-align: center;
		position: relative;
	}
	.footer-stars {
		color: rgba(192, 132, 252, 0.3);
		font-size: 0.9em;
		letter-spacing: 1.5em;
		margin-bottom: 1.5em;
		padding-left: 1.5em;
	}
	.footer-links {
		margin-bottom: 1.5em;
	}
	.booth-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.6em 1.8em;
		background: linear-gradient(135deg, rgba(245,158,11,0.25), rgba(192,132,252,0.25));
		border: 1px solid rgba(245,158,11,0.5);
		border-radius: 30px;
		color: #fcd34d;
		font-weight: 700;
		font-family: 'Cinzel', serif;
		font-size: 0.9em;
		text-decoration: none;
		transition: all 0.3s ease;
		letter-spacing: 0.05em;
	}
	.booth-btn:hover {
		background: linear-gradient(135deg, rgba(245,158,11,0.45), rgba(192,132,252,0.45));
		border-color: #fcd34d;
		box-shadow: 0 0 20px rgba(245,158,11,0.4);
		transform: translateY(-2px);
		color: #fff !important;
		text-shadow: none !important;
	}
	.footer-nav {
		display: flex;
		justify-content: center;
		gap: 1.5em;
		margin-bottom: 1.5em;
		flex-wrap: wrap;
	}
	.footer-nav a {
		color: rgba(167, 139, 250, 0.7);
		text-decoration: none;
		font-size: 0.85em;
		transition: color 0.2s;
	}
	.footer-nav a:hover {
		color: #c084fc;
		text-shadow: none;
	}
	.footer-copy {
		color: rgba(124, 111, 160, 0.8);
		font-size: 0.8em;
		margin: 0.5em 0;
	}
	.footer-desc {
		color: rgba(124, 111, 160, 0.5);
		font-size: 0.75em;
		margin: 0.25em 0 0;
	}
</style>
