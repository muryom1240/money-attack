---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
).slice(0, 6);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 1000px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 2rem 1rem 4rem;
			}
			/* ✨ Hero */
			.hero {
				text-align: center;
				padding: 4rem 1rem 3rem;
				position: relative;
			}
			.hero-badge {
				display: inline-block;
				padding: 0.3em 1.2em;
				background: linear-gradient(135deg, rgba(245,158,11,0.2), rgba(192,132,252,0.2));
				border: 1px solid rgba(245,158,11,0.4);
				border-radius: 30px;
				color: #fcd34d;
				font-size: 0.8em;
				letter-spacing: 0.15em;
				font-family: 'Cinzel', serif;
				margin-bottom: 1.5rem;
			}
			.hero h1 {
				font-size: clamp(2rem, 5vw, 3.5rem);
				margin-bottom: 1rem;
				line-height: 1.2;
			}
			.hero-sub {
				color: rgba(167, 139, 250, 0.8);
				font-size: 1.05em;
				max-width: 500px;
				margin: 0 auto 2.5rem;
				line-height: 1.7;
			}
			.hero-cta {
				display: inline-flex;
				align-items: center;
				gap: 0.5em;
				padding: 0.8em 2.5em;
				background: linear-gradient(135deg, #f59e0b, #c084fc);
				border-radius: 30px;
				color: #0f0a1e;
				font-weight: 700;
				font-family: 'Cinzel', serif;
				font-size: 1em;
				text-decoration: none;
				transition: all 0.3s ease;
				letter-spacing: 0.05em;
				box-shadow: 0 4px 20px rgba(245,158,11,0.3);
			}
			.hero-cta:hover {
				transform: translateY(-3px);
				box-shadow: 0 8px 30px rgba(245,158,11,0.5);
				color: #0f0a1e !important;
				text-shadow: none !important;
			}
			.hero-divider {
				height: 1px;
				background: linear-gradient(90deg, transparent, rgba(192,132,252,0.4), transparent);
				margin: 3rem 0;
			}
			/* ✨ Section title */
			.section-title {
				font-family: 'Cinzel', serif;
				font-size: 1.3em;
				color: #fcd34d;
				text-align: center;
				margin-bottom: 2rem;
				letter-spacing: 0.1em;
			}
			.section-title::before { content: '✦ '; }
			.section-title::after  { content: ' ✦'; }
			/* ✨ Article grid */
			ul {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 1.5rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			ul li:first-child {
				grid-column: 1 / -1;
			}
			ul li a {
				display: block;
				text-decoration: none;
				background: rgba(139, 92, 246, 0.07);
				border: 1px solid rgba(192, 132, 252, 0.2);
				border-radius: 16px;
				overflow: hidden;
				transition: all 0.3s ease;
				height: 100%;
			}
			ul li a:hover {
				background: rgba(139, 92, 246, 0.15);
				border-color: rgba(192, 132, 252, 0.6);
				transform: translateY(-4px);
				box-shadow: 0 8px 30px rgba(139, 92, 246, 0.2);
				color: inherit !important;
				text-shadow: none !important;
			}
			ul li img {
				width: 100%;
				height: 200px;
				object-fit: cover;
				border-radius: 0;
				border: none;
				display: block;
			}
			ul li:first-child img { height: 320px; }
			.card-body {
				padding: 1rem 1.2rem 1.2rem;
			}
			.title {
				font-family: 'Noto Sans JP', sans-serif;
				font-weight: 700;
				font-size: 0.95em;
				color: #e2d9f3;
				line-height: 1.5;
				margin: 0 0 0.5em;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			ul li:first-child .title { font-size: 1.3em; }
			.date {
				color: rgba(167, 139, 250, 0.6);
				font-size: 0.78em;
				margin: 0;
			}
			/* ✨ More button */
			.more-link {
				text-align: center;
				margin-top: 2.5rem;
			}
			.more-link a {
				display: inline-flex;
				align-items: center;
				gap: 0.5em;
				padding: 0.7em 2.5em;
				border: 1px solid rgba(192,132,252,0.5);
				border-radius: 30px;
				color: #c084fc;
				font-family: 'Cinzel', serif;
				font-size: 0.9em;
				text-decoration: none;
				transition: all 0.3s ease;
				letter-spacing: 0.05em;
			}
			.more-link a:hover {
				background: rgba(192,132,252,0.15);
				border-color: #c084fc;
				box-shadow: 0 0 20px rgba(192,132,252,0.3);
				color: #c084fc !important;
				text-shadow: none !important;
			}
			@media (max-width: 720px) {
				ul { grid-template-columns: 1fr; }
				ul li:first-child { grid-column: auto; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-badge">✨ Creator Blog</div>
				<h1>アートウル工房<br/>Artoul Atelier</h1>
				<p class="hero-sub">ローポリ3DCGモデルを制作・販売するクリエイターの工房。<br/>ゲーム開発・3D制作のノウハウを発信中。</p>
				<a href="https://artwldesign.booth.pm/" target="_blank" class="hero-cta">
					🛝 BOOTHショップを見る
				</a>
			</section>

			<div class="hero-divider"></div>

			<p class="section-title">最新の記事</p>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/money-attack/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<div class="card-body">
										<h4 class="title">{post.data.title}</h4>
										<p class="date">
											<FormattedDate date={post.data.pubDate} />
										</p>
									</div>
								</a>
							</li>
						))
					}
				</ul>
				<div class="more-link">
					<a href="/money-attack/blog/">すべての記事を見る →</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
