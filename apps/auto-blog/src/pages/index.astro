---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
).slice(0, 6); // 最新6件を表示
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
				max-width: 100%;
				margin: 0 auto;
				padding: 1rem;
			}
			.hero {
				text-align: center;
				padding: 3rem 1rem 2rem;
				border-bottom: 1px solid #eee;
				margin-bottom: 2rem;
			}
			.hero h1 {
				font-size: 2.5rem;
				margin-bottom: 0.5rem;
			}
			.hero p {
				color: #666;
				font-size: 1.1rem;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
				width: 100%;
			}
			ul li a {
				display: block;
				text-decoration: none;
			}
			.title {
				margin: 0.5rem 0 0.25rem;
				color: rgb(var(--black));
				line-height: 1.3;
				font-size: 1.1rem;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			ul li a:hover .title,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			.more-link {
				text-align: center;
				margin-top: 2rem;
			}
			.more-link a {
				display: inline-block;
				padding: 0.75rem 2rem;
				background: rgb(var(--accent));
				color: white;
				border-radius: 8px;
				text-decoration: none;
				font-weight: bold;
				transition: opacity 0.2s;
			}
			.more-link a:hover {
				opacity: 0.8;
			}
			@media (max-width: 720px) {
				ul li, ul li:first-child {
					width: 100%;
					text-align: center;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>💰 Money Attack Blog</h1>
				<p>AIが毎日自動で書く、お金・副業・効率化のブログ</p>
			</section>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/money-attack/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
				<div class="more-link">
					<a href="/money-attack/blog/">すべての記事を見る →</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
